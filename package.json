{
  "name": "zendo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:https": "PWA_HTTPS=1 vite preview --host",
    "generate-pwa-assets": "pwa-assets-generator",
    "check-typescript": "tsc --noEmit",
    "check-eslint": "ESLINT_USE_FLAT_CONFIG=true eslint src",
    "lint": "npm run check-typescript && npm run check-eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^1.67.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "~18.3.12",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
